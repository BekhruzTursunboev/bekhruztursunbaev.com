# Cloudflare Workers static assets header rules.
#
# Content-hashed build output can be cached forever. Everything else keeps its
# filename when it is regenerated (npm run shots, fonts, logos, images), so it
# gets a month instead: long enough to matter, short enough that a refreshed
# screenshot still reaches returning visitors.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/fonts/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400
/img/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400
/shots/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400
/logos/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Strict-Transport-Security: max-age=31536000
  Content-Security-Policy: default-src 'self'; script-src 'self' __CSP_SCRIPT_HASHES__; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests
